# ================= Shang Backend 环境配置（模板） =================
# 用法：cp .env.example .env 后填写真实值。本模板可提交 git，.env 勿提交。
# 由 application.yaml 的 spring.config.import=optional:file:./.env[.properties] 读取。
# 格式：KEY=VALUE（每行一个，`#` 注释，勿加 export；敏感值留空则用 application.yaml 默认）。

# --- 应用 ---
# 两个前端 dev server 的代理都指向 8086
SERVER_PORT=8086

# --- 数据库 PostgreSQL (pgvector) ---
# 应用只读 DB_URL。宿主机映射非 5432 端口时写进 URL；经端口转发/云映射访问建议加 sslmode=disable
DB_URL=jdbc:postgresql://localhost:5432/shang?sslmode=disable&stringtype=unspecified&connectTimeout=5&socketTimeout=30&tcpKeepAlive=true
DB_USERNAME=shang
DB_PASSWORD=shang
DB_DATABASE=shang
DB_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# --- 对象存储 MinIO（S3 兼容）---
# endpoint 可为 host:port（应用内会补 http://）或完整 URL
MINIO_ENDPOINT=localhost:9000
# 以下为本地演示默认值（与 docker-compose.yml 一致）；生产环境务必替换
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=shang-pivot

# 公网访问前缀，留空则使用 http://{endpoint}/{bucket}/{objectKey}
# MINIO_PUBLIC_BASE_URL=http://localhost:9000/shang-pivot

# --- 鉴权 JWT（本地默认值仅供开发；生产必须替换）---
JWT_SECRET=shang-pivot-dev-jwt-secret-change-me-32bytes-min!!
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- 跨源白名单（部署到域名/公网 IP 时必填，逗号分隔、写精确 Origin）---
# 不填时用 application.yaml 的默认值（localhost + YOUR_SERVER_IP:60084/60085）。
# 现象：浏览器里登录/注册报 "Invalid CORS request"（403），但 curl 不带 Origin 正常 → 就是这里缺部署域。
# SHANG_CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:60084,http://YOUR_SERVER_IP:60085

# --- 智能客服 LLM（V3.0；system_config 的 LLM 分组可覆盖这些默认值）---
# OpenAI 兼容网关地址 + Key + 模型；Key 留空 = 智能客服降级模式（兜底话术 + 词法推荐）
LLM_BASE_URL=https://your-openai-compatible-gateway.example/v1
LLM_API_KEY=
LLM_MODEL=cn:deepseek-v4.1-flash
# Embedding（OpenAI 兼容 /v1/embeddings；三项同填才启用向量检索，否则词法检索）
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024

# V3.1 Agent 编排：legacy=V3.0 两阶段（默认，可回滚）；graph=LangGraph4j 图编排
AGENT_ENGINE=legacy
# LLM 客户端：legacy=JDK HttpClient SSE（默认）；spring-ai=Spring AI ChatModel 适配层
AGENT_LLM_CLIENT=legacy
# 图 checkpoint：postgres=每个 run 落 LG4JThread/LG4JCheckpoint（默认，DB 异常自动降级）；memory=仅进程内
AGENT_CHECKPOINT=postgres

# --- 微信小程序（P2 接入时填写）---
MINIAPP_APPID=
MINIAPP_SECRET=