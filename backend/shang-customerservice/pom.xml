<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.shangpivot</groupId>
		<artifactId>shang-pivot</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>shang-customerservice</artifactId>
	<name>shang-customerservice</name>
	<description>Customer service bounded context (V3.0 smart customer service)</description>

	<properties>
		<!-- 评估层（@Tag("eval")）默认跳过：LLM 裁判有调用成本，手动 mvn test -Peval 触发 -->
		<eval.excludedGroups>eval</eval.excludedGroups>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.shangpivot</groupId>
			<artifactId>shang-common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.shangpivot</groupId>
			<artifactId>shang-identity-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.shangpivot</groupId>
			<artifactId>shang-commerce-api</artifactId>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations-jakarta</artifactId>
		</dependency>
		<!-- V3.1 Agent runtime: model abstraction + graph orchestration. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bsc.langgraph4j</groupId>
			<artifactId>langgraph4j-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bsc.langgraph4j</groupId>
			<artifactId>langgraph4j-spring-ai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bsc.langgraph4j</groupId>
			<artifactId>langgraph4j-postgres-saver</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>${eval.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
			<!-- 暴露 Golden 数据集给 shang-server 的集成测试 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>eval</id>
			<properties>
				<eval.excludedGroups>none</eval.excludedGroups>
			</properties>
		</profile>
	</profiles>
</project>
